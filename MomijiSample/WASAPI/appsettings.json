{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Momiji": "Information",
      "Momiji.Sample": "Trace"
    },
    "Console": {
      "FormatterName": "Simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "HH:mm:ss.ffff",
        "UseUtcTimestamp": false
      }
    }
  },
  "AllowedHosts": "*",

  "Momiji.Core.WorkQueue.WorkQueueManager": {
    "UsageClass": "Pro Audio",
    "BasePriority": 0,
    "TaskId": 0
  }
}
